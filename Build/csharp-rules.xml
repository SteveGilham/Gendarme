<gendarme>
  <ruleset name="default">
    <rules include="*"
           from="Gendarme.Rules.BadPractice.dll" />
    <rules include="*"
           from="Gendarme.Rules.Concurrency.dll" />
    <!-- 8 instances of False positive/off by one in ProvideCorrectArgumentsToFormattingMethodsRule -->
    <!-- 230 instances of CheckParametersNullityInVisibleMethodsRule -->
    <rules include="*"
           exclude="ProvideCorrectArgumentsToFormattingMethodsRule | CheckParametersNullityInVisibleMethodsRule"
           from="Gendarme.Rules.Correctness.dll" />
    <!-- AvoidSmallNamespaceRule doesn't account for specialized code -->
    <!-- and cannot yet be suppressed by attribute -->
    <rules include="*"
           exclude="AvoidSmallNamespaceRule"
           from="Gendarme.Rules.Design.dll" />
    <rules include="*"
           from="Gendarme.Rules.Design.Generic.dll" />
    <rules include="*"
           from="Gendarme.Rules.Design.Linq.dll" />
    <rules include="*"
           from="Gendarme.Rules.Exceptions.dll" />
    <!-- DelegatesPassedToNativeCodeMustIncludeExceptionHandlingRule false positives from handler.?Fire type construct -->
    <rules include="*"
           exclude="DelegatesPassedToNativeCodeMustIncludeExceptionHandlingRule"
           from="Gendarme.Rules.Interoperability.dll" />
    <rules include="*"
           from="Gendarme.Rules.Interoperability.Com.dll" />
    <rules include="*"
           from="Gendarme.Rules.Naming.dll" />
    <rules include="*"
           from="Gendarme.Rules.Performance.dll" />
    <rules include="*"
           from="Gendarme.Rules.Portability.dll" />
    <rules include="*"
           from="Gendarme.Rules.Security.dll" />
    <rules include="*"
           from="Gendarme.Rules.Security.Cas.dll" />
    <rules include="*"
           from="Gendarme.Rules.Serialization.dll" />
    <!-- Use the relaxed variant - needs to relax some more -->
    <!-- 200 at full strength vs 6 relaxed -->
    <!-- 29 sibling cases -->
    <rules include="*"
           exclude="AvoidCodeDuplicatedInSiblingClassesRule | RelaxedAvoidCodeDuplicatedInSameClassRule | AvoidCodeDuplicatedInSameClassRule"
           from="Gendarme.Rules.Smells.dll" />
    <rules include="*"
           from="Gendarme.Rules.Ui.dll" />
    <rules include="*"
           from="Gendarme.Rules.Maintainability.dll" />
    <rules include="*"
           from="Gendarme.Rules.Gendarme.dll" />
    <rules include="*"
           from="Gendarme.Rules.Globalization.dll" />
    <rules include="*"
           from="AltCode.Rules.General.dll" />
    <rules include="*"
           from="AltCode.Rules.PowerShell.dll" />
  </ruleset>
</gendarme>